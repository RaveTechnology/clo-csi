{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["projectID", "installationID", "existingSecret", "image", "tls"],
  "properties": {
    "projectID": {"type": "string", "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"},
    "installationID": {"type": "string", "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"},
    "existingSecret": {"type": "string", "minLength": 1},
    "existingSecretKey": {"type": "string", "minLength": 1},
    "image": {
      "type": "object", "required": ["repository", "digest", "pullPolicy"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "tls": {"type": "object", "required": ["existingSecret"], "properties": {"existingSecret": {"type": "string", "minLength": 1}}},
    "kubeletRoot": {"type": "string", "pattern": "^/[a-zA-Z0-9_/-]+$"},
    "journalRoot": {"type": "string", "pattern": "^/[a-zA-Z0-9_/-]+$"},
    "sidecars": {
      "type": "object", "additionalProperties": {"type": "string", "pattern": "@sha256:[a-f0-9]{64}$"}
    }
  }
}
